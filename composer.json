{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/g123udini/code-style-rules.git"
        },
        {
            "type": "git",
            "url": "https://github.com/g123udini/phpstan-rules.git"
        },
        {
            "type": "git",
            "url": "https://github.com/g123udini/psalm-rules.git"
        },
        {
            "type": "git",
            "url": "https://github.com/g123udini/component-bundle.git"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-redis": "^6.2",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "doctrine/orm": "^3.2",
        "g123udini/component-bundle": "^4.4",
        "nelmio/api-doc-bundle": "^4",
        "sentry/sentry-symfony": "^5.6",
        "symfony/asset": "7.2.*",
        "symfony/console": "7.2.*",
        "symfony/dotenv": "7.2.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.2.*",
        "symfony/http-client": "7.2.*",
        "symfony/lock": "7.2.*",
        "symfony/monolog-bundle": "^3.8",
        "symfony/process": "7.2.*",
        "symfony/property-info": "7.2.*",
        "symfony/runtime": "7.2.*",
        "symfony/twig-bundle": "7.2.*",
        "symfony/validator": "7.2.*",
        "symfony/yaml": "7.2.*",
        "systemeio/test-for-candidates": "^1.0",
        "twig/extra-bundle": "^3.8",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "g123udini/php-cs-fixer": "^1.0",
        "g123udini/phpstan": "^1.0",
        "g123udini/psalm": "^1.0",
        "phpunit/phpunit": "^12.4",
        "symfony/browser-kit": "7.2.*",
        "symfony/css-selector": "7.2.*",
        "symfony/debug-bundle": "7.2.*",
        "symfony/maker-bundle": "^1.60",
        "symfony/phpunit-bridge": "7.2.*",
        "symfony/web-profiler-bundle": "7.2.*"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "php-http/discovery": false
        },
        "audit": {
            "ignore": [
                "PKSA-xf5h-y6vg-qj98",
                "PKSA-py8y-z9q7-q197",
                "PKSA-v5yj-8nmz-sk2q",
                "PKSA-ft77-7h5f-p3r6",
                "PKSA-b14r-zh1d-vdrc"
            ]
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "SystemeioTestTask\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SystemeioTestTask\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "phpcscheck" : [
            "php-cs-fixer fix --dry-run"
        ],
        "phpcsfix" : [
            "php-cs-fixer fix"
        ],
        "phpstan" : [
            "console cache:warmup",
            "phpstan clear-result-cache",
            "phpstan analyse"
        ],
        "phpunit" : [
            "bin/phpunit"
        ],
        "psalm" : [
            "console cache:warmup",
            "./vendor/bin/psalm --no-cache"
        ],
        "lint" : [
            "console lint:container"
        ],
        "doctrine" : [
            "console doctrine:schema:validate --skip-sync"
        ],
        "check" : [
            "console cache:warmup",
            "composer phpcscheck",
            "composer phpstan",
            "composer psalm",
            "composer lint",
            "composer phpunit",
            "composer doctrine"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.2.*",
            "docker": false
        }
    }
}
